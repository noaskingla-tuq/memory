{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "out"
  },
  "include": ["src/**/*", "types/**/*.d.ts"],
  "exclude": ["src/ui"]
}
