{
  "schemaVersion": 2,
  "kind": "plugin",
  "id": "teamuq.memory",
  "name": "Cairn記憶管理",
  "icon": "cairn-icon.png",
  "version": "@VERSION@",
  "publisher": "teamuq",
  "description": "TeamUQ 對話記憶：為每個 agent 保存可追溯的記憶，資料留在本機。",
  "pluginApi": "^2.0.0",
  "minCoreVersion": ">=1.7.12",
  "hostApis": [{ "id": "teamuq.host-data", "range": "^1.1.0" }],
  "trustTier": "full-trust",
  "entry": { "ui": "ui/index.html", "backend": "backend.mjs" },
  "contributes": {
    "views": [
      { "id": "memory", "title": "Cairn記憶管理", "icon": "cairn-icon.png", "entry": "ui/index.html", "presentations": ["tab", "fullpage"], "defaultPresentation": "tab" }
    ]
  },
  "resources": { "memoryMB": 512, "cpuThreads": 1, "maxSessions": 4, "idleUnloadSec": 180, "bootTimeoutSec": 30 },
  "permissions": ["ui:view", "backend:invoke", "agent:avatar-read", "work-records:read", "agent-directory:read", "project-directory:read", "plugin-state:read", "data:legacy-migrate", "settings:plugin", "ai:chat", "program:data:projects:write", "program:data:tasks:write"],
  "settingsSchema": {
    "title": "工作紀錄 AI 整理",
    "summary": "原始工作紀錄儲存在本機；預設把請求與成果送到所選 AI 提供者，整理成可追溯的記憶。",
    "fields": [
      { "key": "organizationEnabled", "type": "toggle", "label": "啟用 AI 整理", "default": true, "help": "預設啟用。關閉時仍儲存原始工作紀錄；重新開啟會接續處理等待中的紀錄。" },
      { "key": "organizationProvider", "type": "text", "label": "AI 提供者 ID", "default": "", "maxLength": 128, "help": "留空使用目前可用的預設提供者；指定 ID 不可用時會暫停整理。" },
      { "key": "organizationModel", "type": "text", "label": "模型 ID", "default": "", "maxLength": 128, "help": "留空使用提供者的預設模型；不使用 astra。" },
      { "key": "organizationContextBudget", "type": "range", "label": "AI 輸入預算", "default": 32768, "min": 8192, "max": 262144, "step": 8192, "unit": "bytes", "help": "以 UTF-8 bytes 保守估算，並非精確 token 數；Cairn 另有每次模型輸入上限。" },
      { "key": "organizationFrequency", "type": "choice", "label": "整理頻率", "options": [{ "value": "daily", "label": "每天一輪" }, { "value": "immediate", "label": "即時整理" }], "default": "daily", "help": "每天一輪預設使用本機時間 02:00；即時整理會處理同步後的等待項目。" },
      { "key": "organizationDailyTime", "type": "text", "label": "每日開始時間（本機時區）", "default": "02:00", "maxLength": 5, "help": "24 小時制 HH:mm；只在每天一輪時使用。" }
    ]
  },
  "backendMethods": ["ui.overview", "ui.agentStats", "ui.list", "ui.search", "ui.get", "ui.forget", "ui.status"],
  "data": { "uninstall": "keep", "legacyMigrations": [{ "id": "cairn-v1", "source": "memory-cairn-v1", "target": "memory-cairn-v1" }] }
}
