{
  "schemaVersion": 2,
  "kind": "plugin",
  "id": "teamuq.memory",
  "name": "TeamUQ 記憶",
  "version": "@VERSION@",
  "publisher": "teamuq",
  "description": "TeamUQ 對話記憶：為每個 agent 保存可追溯的記憶，資料留在本機。",
  "pluginApi": "^2.0.0",
  "minCoreVersion": ">=1.7.0",
  "trustTier": "full-trust",
  "entry": { "ui": "ui/index.html", "backend": "backend.mjs" },
  "contributes": {
    "views": [
      { "id": "memory", "title": "記憶", "entry": "ui/index.html", "presentations": ["tab", "fullpage"], "defaultPresentation": "tab" }
    ]
  },
  "resources": { "memoryMB": 512, "cpuThreads": 1, "maxSessions": 4, "idleUnloadSec": 180, "bootTimeoutSec": 30 },
  "permissions": ["ui:view", "backend:invoke", "agent:avatar-read"],
  "backendMethods": ["ui.overview", "ui.agentStats", "ui.list", "ui.search", "ui.get", "ui.forget", "ui.status"],
  "data": { "uninstall": "keep" }
}
