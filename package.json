{
  "name": "teamuq-plugin-memory",
  "version": "1.4.0",
  "private": true,
  "description": "TeamUQ full-trust memory plugin (backend entry, Cairn adapter, memory application and domain)",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "typecheck:ui": "tsc -p tsconfig.ui.json",
    "tokens:sync": "node tools/sync-tokens.mjs",
    "tokens:verify": "node tools/sync-tokens.mjs --verify",
    "types:sync": "node vendor/teamuq-devkit/tuq-plugin-tool.mjs types --out types",
    "build:ts": "tsc -p .",
    "test": "npm run build:ts && node --test test/*.test.mjs",
    "verify:source": "node tools/verify-source-untouched.mjs",
    "contract:verify": "node tools/verify-contract.mjs",
    "contract:sync": "node tools/sync-contract.mjs",
    "devkit:sync": "node tools/sync-vendor.mjs --only devkit",
    "build": "node tools/build.mjs",
    "dev:pack": "node tools/dev-pack.mjs",
    "verify:artifact": "node tools/verify-artifact.mjs",
    "release": "node tools/release.mjs",
    "check:secrets": "node tools/check-no-secrets.mjs",
    "check": "npm run test && npm run typecheck:ui && npm run tokens:verify && npm run contract:verify && npm run verify:source && npm run check:secrets",
    "perf:ui": "node tools/perf-ui.mjs"
  },
  "dependencies": {
    "cairn-memory": "git+https://github.com/Cairn-ink/cairn-memory.git#7197d80035a015db195d7724729926f8749afd32",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.21.5",
    "typescript": "5.9.3"
  }
}
